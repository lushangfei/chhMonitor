{
  "manifest_version": 3,
  "name": "CHH / V2EX 新帖提醒（非官方）",
  "version": "1.0.1",
  "description": "非官方第三方工具：监控 Chiphell 与 V2EX 二手交易新帖，可选桌面提示和提示音，支持关键词/发帖人过滤。",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://www.chiphell.com/*", "https://www.v2ex.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CHH / V2EX 新帖监控",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
